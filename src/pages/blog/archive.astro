---
import BlogLayout from '../../layouts/BlogLayout.astro'
import BlogUnavailable from '../../components/BlogUnavailable.astro'
import { BlogDataUnavailableError, formatPostDate, getPublishedPosts, getTagEntries } from '../../utils/posts'

export const prerender = false

let allPosts: Awaited<ReturnType<typeof getPublishedPosts>> = []
let blogUnavailable = false
try {
  allPosts = await getPublishedPosts()
} catch (error) {
  if (!(error instanceof BlogDataUnavailableError)) throw error
  blogUnavailable = true
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
  Astro.response.headers.set('Retry-After', '60')
}
const years = new Map<number, typeof allPosts>()

for (const post of allPosts) {
  const year = post.data.pubDate.getFullYear()
  years.set(year, [...(years.get(year) ?? []), post])
}

const archiveYears = Array.from(years.entries()).sort(([a], [b]) => b - a)
const tagCount = getTagEntries(allPosts).length
---

<BlogLayout
  title="ANeko - Home | 博客"
  description="按年份和发布时间浏览 ANeko - Home 博客的全部文章，快速查找开发实践、系统配置、技术笔记与日常记录。"
  activeSection="archive"
  compactHeader
>
  <section class="blogArchivePage" aria-labelledby="archive-title">
    <header class="blogListHeader blogArchivePageHeader">
      <div>
        <p>文章归档</p>
        <h1 id="archive-title">文章归档</h1>
      </div>
      {!blogUnavailable && <span>{allPosts.length} 篇文章 / {tagCount} 个标签</span>}
    </header>

    {blogUnavailable ? <BlogUnavailable /> : archiveYears.length > 0 ? archiveYears.map(([year, posts]) => (
      <section class="blogArchiveYear">
        <div class="blogArchiveYearLabel">
          <h2>{year}</h2>
          <span>{posts.length} 篇</span>
        </div>
        <div class="blogArchiveTimeline">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`}>
              <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate).slice(5)}</time>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span>{post.data.tags[0] ?? '随笔'}</span>
            </a>
          ))}
        </div>
      </section>
    )) : (
      <div class="blogEmptyState">
        <h2>暂无归档</h2>
        <p>发布第一篇文章后，这里会按年份自动整理</p>
      </div>
    )}
  </section>
</BlogLayout>
