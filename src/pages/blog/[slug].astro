---
import BlogToc from '../../components/BlogToc.astro'
import BlogUnavailable from '../../components/BlogUnavailable.astro'
import BlogLayout from '../../layouts/BlogLayout.astro'
import { renderBlogMarkdown } from '../../utils/blog-markdown'
import { BlogDataUnavailableError, formatPostDate, getBlogPost, getPublishedPosts, getReadingTime, tagToSlug } from '../../utils/posts'

export const prerender = false

const slug = Astro.params.slug || ''
let post: Awaited<ReturnType<typeof getBlogPost>> = null
let allPosts: Awaited<ReturnType<typeof getPublishedPosts>> = []
let blogUnavailable = false
const [postResult, listResult] = await Promise.allSettled([
  getBlogPost(slug),
  getPublishedPosts(),
])

if (postResult.status === 'fulfilled') {
  post = postResult.value
} else {
  if (!(postResult.reason instanceof BlogDataUnavailableError)) throw postResult.reason
  blogUnavailable = true
}

// Navigation is optional: a list failure must not hide an available article.
if (listResult.status === 'fulfilled') {
  allPosts = listResult.value
} else {
  console.warn('[blog] next article navigation unavailable', {
    errorType: listResult.reason instanceof Error ? listResult.reason.name : typeof listResult.reason,
  })
}

let rendered: Awaited<ReturnType<typeof renderBlogMarkdown>> | null = null
if (post) {
  if (typeof post.body !== 'string') {
    blogUnavailable = true
  } else {
    try {
      rendered = await renderBlogMarkdown(post.body)
    } catch (error) {
      blogUnavailable = true
      console.error('[blog] article rendering failed', {
        errorType: error instanceof Error ? error.name : typeof error,
      })
    }
  }
}

const postIndex = post ? allPosts.findIndex((item) => item.id === post.id) : -1
const nextPost = post && postIndex >= 0 && allPosts.length > 1
  ? allPosts[(postIndex + 1) % allPosts.length]
  : null

if (blogUnavailable) {
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
  Astro.response.headers.set('Retry-After', '60')
} else if (!post) {
  Astro.response.status = 404
}
---

<BlogLayout
  title="ANeko - Home | 博客"
  description={post?.data.description || (blogUnavailable ? '博客文章暂时无法读取。' : '未找到请求的博客文章。')}
  keywords={post ? `ANeko,个人博客,${post.data.tags.join(',')}` : 'ANeko,个人博客'}
  image={post?.data.heroImage}
  noindex={!blogUnavailable && !post}
  article={post && !blogUnavailable ? {
    headline: post.data.title,
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updatedDate?.toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  } : undefined}
  compactHeader
>
  <script>
    import '../../scripts/blog-code-blocks.js'
    import '../../scripts/github-cards.js'
  </script>
  {post && rendered ? (
    <article class="blogArticle">
      <nav class="blogBreadcrumb" aria-label="文章路径">
        <a href="/blog/">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          <span>全部文章</span>
        </a>
        <span>/</span>
        <span>{post.data.tags[0] ?? '随笔'}</span>
      </nav>

      <header class="blogArticleHeader">
        <div class="blogArticleMeta">
          <span>{post.data.tags[0] ?? '随笔'}</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
          <small>阅读约 {getReadingTime(post)} 分钟</small>
          <small>作者 {post.data.author}</small>
        </div>
        <div class="blogArticleTitle">
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="blogArticleTags" aria-label="文章标签">
              {post.data.tags.map((tag) => (
                <a href={`/blog/tag/${tagToSlug(tag)}/`}>#{tag}</a>
              ))}
            </div>
          )}
        </div>
      </header>

      {post.data.heroImage && (
        <figure class="blogArticleHero">
          <img src={post.data.heroImage} alt={post.data.title} loading="eager" decoding="async" />
        </figure>
      )}

      <div class="blogArticleContent">
        <div class="blogArticleBody blogProse" set:html={rendered.html}></div>
        <BlogToc headings={rendered.headings} />
      </div>

      {nextPost && (
        <div class="blogArticleEnd">
          <div>
            <p>下一篇文章</p>
            <h2>继续翻阅</h2>
          </div>
          <a href={`/blog/${nextPost.id}/`}>
            <span>{nextPost.data.title}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      )}
    </article>
  ) : (
    <section class="blogIndex blogListingPage">
      {blogUnavailable ? <BlogUnavailable /> : (
        <div class="blogEmptyState">
          <h1>文章不存在</h1>
          <p>这篇文章尚未发布，或已经移除。</p>
        </div>
      )}
    </section>
  )}
</BlogLayout>
