---
import BlogLayout from '../../layouts/BlogLayout.astro'
import { BlogDataUnavailableError, getPublishedPosts, getTagEntries } from '../../utils/posts'

export const prerender = false

let posts: Awaited<ReturnType<typeof getPublishedPosts>> = []
let statsUnavailable = false
try {
  posts = await getPublishedPosts()
} catch (error) {
  if (!(error instanceof BlogDataUnavailableError)) throw error
  statsUnavailable = true
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const tags = getTagEntries(posts)
const firstYear = posts.at(-1)?.data.pubDate.getFullYear()
---

<BlogLayout
  title="ANeko - Home | 博客"
  description="了解 ANeko - Home 博客的内容方向，这里收集项目开发实践、系统配置笔记、技术经验，以及值得留下一份文字记录的日常思考。"
  activeSection="about"
  compactHeader
>
  <section class="blogAboutPage" aria-labelledby="about-title">
    <div class="blogAboutIntro">
      <div class="blogAboutCopy">
        <p>关于博客</p>
        <h1 id="about-title">网络上的一块自留地</h1>
        <p class="blogAboutLead">ANeko Blog</p>
        <p>这里收集项目开发中的实践、系统配置笔记，以及那些值得留下一份文字记录的日常</p>
        <div class="blogAboutActions">
          <a href="https://github.com/AMahiru30" target="_blank" rel="noreferrer">GitHub</a>
          <a href="/" data-astro-reload>返回主页</a>
        </div>
      </div>
    </div>

    <dl class="blogAboutStats">
      <div><dt>文章</dt><dd>{statsUnavailable ? '暂不可用' : String(posts.length).padStart(2, '0')}</dd></div>
      <div><dt>标签</dt><dd>{statsUnavailable ? '暂不可用' : String(tags.length).padStart(2, '0')}</dd></div>
      <div><dt>开始记录</dt><dd>{statsUnavailable ? '暂不可用' : firstYear ?? '—'}</dd></div>
    </dl>
  </section>
</BlogLayout>
