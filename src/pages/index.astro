---
import PageContent from '../components/PageContent.vue'
import PageFooter from '../components/PageFooter.vue'
import SiteLayout from '../layouts/SiteLayout.astro'
import { getBindings } from '../utils/cloudflare'
import { readSiteContent } from '../utils/site-content'
import '../styles/home.css'

export const prerender = false

const siteContent = await readSiteContent(getBindings())
---

<SiteLayout description={siteContent.profile.description}>
  <div class="homeFrame">
    <main class="at-main homeStructure">
      <PageContent content={siteContent} client:load />
    </main>
    <PageFooter client:visible />
  </div>
</SiteLayout>
