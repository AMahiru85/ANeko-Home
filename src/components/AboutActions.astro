---
import ButtonIcon from './ButtonIcon.vue';
import ButtonMagnet from './ButtonMagnet.vue';
---
<div class="about-actions" data-about-actions>
  <ButtonMagnet client:load><a class="about-action about-action-back" href="/" aria-label="Back to Home"><ButtonIcon name="back" width="1.4rem" height="1.4rem" /></a></ButtonMagnet>
  <ButtonMagnet client:load><a class="about-action about-action-email" href="mailto:gbeaugonin@gmail.com" aria-label="Copy email" data-email-copy><ButtonIcon name="email" width="1.4rem" height="1.4rem" /></a></ButtonMagnet>
  <ButtonMagnet client:load><a class="about-action" href="https://x.com/gabrielbgnn" target="_blank" rel="noreferrer" aria-label="X (Twitter)"><ButtonIcon name="x" width="1.3rem" height="1.2rem" /></a></ButtonMagnet>
  <ButtonMagnet client:load><a class="about-action" href="https://www.linkedin.com/in/gbeaugonin/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><ButtonIcon name="linkedin" width="1.3rem" height="1.3rem" /></a></ButtonMagnet>
</div>
<script>
  let listeners: AbortController | undefined;
  const setup = () => {
    listeners?.abort();
    const row=document.querySelector<HTMLElement>('[data-about-actions]');
    if(!row)return;
    listeners=new AbortController();
    const {signal}=listeners;
    const email=row.querySelector<HTMLAnchorElement>('[data-email-copy]');
    const resize=()=>email?.setAttribute('aria-label',window.innerWidth<=768?'Send email':'Copy email');
    resize();window.addEventListener('resize',resize,{signal});
    email?.addEventListener('click',async(event)=>{
      if(window.innerWidth<=768)return;
      event.preventDefault();
      try{await navigator.clipboard.writeText('gbeaugonin@gmail.com');email.dataset.copied='true';}catch{}
    },{signal});
    window.addEventListener('keydown',(event)=>{if(event.key==='Escape')row.querySelector<HTMLAnchorElement>('.about-action-back')?.click();},{signal});
  };
  document.addEventListener('astro:page-load',setup);
  document.addEventListener('astro:before-swap',()=>listeners?.abort());
  if(document.readyState==='complete')setup();
</script>
<style>
  .about-actions { display:flex; gap:.4rem; align-items:center; }
  .about-action { width:5.4rem; height:5.4rem; min-width:5.4rem; padding:2rem; display:flex; align-items:center; justify-content:center; border:0; border-radius:1.5rem; background:#fff; color:#1a1a1a; cursor:pointer; transition:scale .3s cubic-bezier(.075,.82,.165,1),border-radius .3s cubic-bezier(.785,.135,.15,.86),background-color .3s cubic-bezier(.785,.135,.15,.86); }
  .about-action:hover { scale:1.037; }
  .about-action:active { scale:.97; }
  .about-action-back { background:#000; color:#fff; border-radius:50%; }
  .about-action-email { position:relative; }
  .about-action-email::after { content:'click to copy'; position:absolute; top:calc(100% + .8rem); left:50%; transform:translateX(-50%); font-size:1.2rem; white-space:nowrap; opacity:0; pointer-events:none; transition:opacity .2s ease-out; }
  .about-action-email:hover::after { opacity:1; }
  .about-action-email[data-copied="true"]::after { content:'copied to clipboard'; }
  @media (max-width:768px) { .about-action-email::after { display:none; } }
  @media (max-width:768px) { .about-action { width:5.4rem; height:5.4rem; min-width:5.4rem; } }
</style>
