---
import { translate } from '../lib/language';
import { languageFromPath } from '../lib/locale';

interface Piece { text: string; ink?: boolean; href?: string }
interface Props { as?: 'p' | 'h4' | 'li'; content: Piece[]; delay?: number }
const locale = languageFromPath(Astro.url.pathname);
const { as: Tag = 'p', content, delay = 0 } = Astro.props;
---
<Tag class="about-rich-text" data-about-rich-text data-base-delay={delay}>
  {content.map((part) => part.href
    ? <a href={part.href} target="_blank" rel="noopener noreferrer" class:list={[part.ink && 'about-ink', 'about-rich-link']} data-about-part>{translate(part.text, locale)}</a>
    : <span class:list={[part.ink && 'about-ink']} data-about-part>{translate(part.text, locale)}</span>)}
</Tag>
<style>
  .about-rich-text { margin: 0; padding: 0; color: #9f9f9f; font-family: 'Suisse Intl',Arial,sans-serif; font-size: 2.4rem; line-height: 1.24; letter-spacing: 0; font-weight: 400; }
  h4.about-rich-text { font-size: 1.4rem; line-height: 1; text-wrap: balance; }
  .about-ink { color: #1a1a1a; font-weight: 400; }
  .about-rich-link { text-decoration: none; transition: opacity .2s ease-out; }
  .about-rich-link:hover, .about-rich-link:active { opacity: .6; }
  .about-rich-text :global(.about-line-clip) { display: block; overflow: hidden; }
  .about-rich-text :global(.about-line-track) { display: block; }
  .about-rich-text :global(.about-line-spacer) { display: block; }
  @media (max-width: 768px) {
    .about-rich-text { font-size: 1.8rem; line-height: 1.24; }
    h4.about-rich-text { font-size: 1.4rem; line-height: 1; }
    .about-ink, .about-rich-link { white-space: nowrap; }
  }
</style>
