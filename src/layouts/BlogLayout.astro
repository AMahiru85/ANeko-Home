---
import HeaderIsland from '../components/HeaderIsland.vue'
import LeftSidebar from '../components/LeftSidebar.vue'
import PageFooter from '../components/PageFooter.vue'
import SiteLayout from './SiteLayout.astro'
import { getBindings } from '../utils/cloudflare'
import { readHomeConfig } from '../utils/site-config'

interface Props {
  title: string
  description: string
  keywords?: string
  image?: string
  noindex?: boolean
  article?: {
    headline: string
    publishedTime: string
    modifiedTime?: string
    author: string
    tags?: string[]
  }
  activeSection?: 'articles' | 'archive' | 'about' | 'manage'
  compactHeader?: boolean
}

const {
  title,
  description,
  keywords = 'ANeko,个人博客,开发,技术笔记',
  image,
  noindex = false,
  article,
  activeSection = 'articles',
  compactHeader = false,
} = Astro.props
const homeConfig = await readHomeConfig(getBindings())
---

<SiteLayout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  noindex={noindex}
  article={article}
  loadingMode="blog-entry"
  breadcrumb={{ name: '博客', path: '/blog/' }}
>
  <main class="at-main blogShell">
    <LeftSidebar homeConfig={homeConfig} transition:persist="blog-sidebar" />
    <div class="at-right blogRight">
      <HeaderIsland
        page="blog"
        blogSection={activeSection}
        compact={compactHeader}
        client:load
        transition:persist="blog-header"
      />
      <div class="blogRouteContent" transition:name="blog-content">
        <slot />
      </div>
    </div>
  </main>
  <PageFooter client:visible />
</SiteLayout>
